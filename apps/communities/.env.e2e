# e2e build env (BFE-124). Committed on purpose: no secrets, only fake hosts.
# `pnpm --filter bze-communities e2e:build` bakes these NEXT_PUBLIC_* values into the build the
# Playwright suite runs against. Every chain/aggregator call goes to a *.e2e.test host that the
# suite answers from e2e/fixtures/ (see e2e/README.md), so nothing reaches a real node.
# Derived from .env.dist (testnet): the fixtures were recorded on testnet.

#app params
NEXT_PUBLIC_APP_NAME=COMMUNITIES E2E
NEXT_PUBLIC_COMMUNITIES_ENABLED=true

# Ecosystem navigation
NEXT_PUBLIC_ECOSYSTEM_EXCLUDED=communities
NEXT_PUBLIC_ECOSYSTEM_LINK_STAKING=https://testnet-staking.getbze.com
NEXT_PUBLIC_ECOSYSTEM_LINK_DEX=https://testnet-dex.getbze.com
NEXT_PUBLIC_ECOSYSTEM_LINK_BURNER=https://testnet-burner.getbze.com
NEXT_PUBLIC_ECOSYSTEM_LINK_FACTORY=https://testnet-factory.getbze.com
NEXT_PUBLIC_ECOSYSTEM_LINK_COMMUNITIES=https://testnet-communities.getbze.com

# Mocked hosts (answered by e2e/support/mock-network.ts)
NEXT_PUBLIC_REST_ENDPOINT=https://lcd.e2e.test
NEXT_PUBLIC_REST_URL=https://lcd.e2e.test
NEXT_PUBLIC_RPC_ENDPOINT=wss://rpc.e2e.test
NEXT_PUBLIC_RPC_URL=wss://rpc.e2e.test
NEXT_PUBLIC_AGG_API_HOST=https://agg.e2e.test

#BZE chain
NEXT_PUBLIC_CHAIN_ID=bzetestnet-3
NEXT_PUBLIC_CHAIN_NAME="BeeZee Testnet 3"
NEXT_PUBLIC_CHAIN_NATIVE_ASSET_DENOM="ubze"
NEXT_PUBLIC_CHAIN_IS_TESTNET=true
NEXT_PUBLIC_CHAIN_ADDRESS_PREFIX=bze

#USDC
NEXT_PUBLIC_USDC_IBC_DENOM=factory/bze1z3mkcr2jz424w6m49frgjmy9uhlrx69phqwg3l/testusd

# Skip / cross-chain off: no Skip proxy calls, no other chains' endpoints.
NEXT_PUBLIC_CROSS_CHAIN_ENABLED=false
NEXT_PUBLIC_WALLET_CHAINS_NAMES="beezee,BeeZee Testnet 3"

NEXT_PUBLIC_EXPLORER_URL=https://testnet.explorer.chaintools.tech
NEXT_PUBLIC_EXPLORER_CHAIN=beezee
