# Production (mainnet) build values for this app. Every NEXT_PUBLIC_* value is
# public by definition — it is inlined into the client bundle at build time.
# No secrets belong in this file.

#app params
NEXT_PUBLIC_APP_NAME=DEX

# Ecosystem navigation — exclude this app (mainnet links are the code defaults)
NEXT_PUBLIC_ECOSYSTEM_EXCLUDED=dex

#BZE Chain endpoints
NEXT_PUBLIC_REST_ENDPOINT=https://rest.getbze.com
NEXT_PUBLIC_RPC_ENDPOINT=wss://rpc.getbze.com
NEXT_PUBLIC_AGG_API_HOST=https://getbze.com
NEXT_PUBLIC_CHAIN_REGISTRY_ASSETS_URL=https://raw.githubusercontent.com/cosmos/chain-registry/master/beezee/assetlist.json

#BZE chain
NEXT_PUBLIC_CHAIN_ID=beezee-1
NEXT_PUBLIC_CHAIN_NAME="beezee"
NEXT_PUBLIC_CHAIN_NATIVE_ASSET_DENOM="ubze"
NEXT_PUBLIC_CHAIN_IS_TESTNET=false
NEXT_PUBLIC_CHAIN_ADDRESS_PREFIX=bze

#USDC
NEXT_PUBLIC_USDC_IBC_DENOM="ibc/6490A7EAB61059BFC1CDDEB05917DD70BDF3A611654162A1A47DB930D40D8AF4"

#cross-chain (Skip) 
NEXT_PUBLIC_CROSS_CHAIN_ENABLED=true
NEXT_PUBLIC_FOREIGN_FEE_SLIPPAGE=2

#other chains
NEXT_PUBLIC_WALLET_CHAINS_NAMES="beezee,archway,osmosis,omniflixhub,jackal,noble,atomone"
#archway
NEXT_PUBLIC_RPC_URL_ARCHWAY=wss://rpc-archway.mzonder.com
NEXT_PUBLIC_REST_URL_ARCHWAY=https://api.mainnet.archway.io
#osmosis
NEXT_PUBLIC_RPC_URL_OSMOSIS=wss://rpc.osmosis.chaintools.tech
NEXT_PUBLIC_REST_URL_OSMOSIS=https://api.osmosis.chaintools.tech
#noble
NEXT_PUBLIC_RPC_URL_NOBLE=wss://rpc-noble.keplr.app
NEXT_PUBLIC_REST_URL_NOBLE=https://noble-api.polkachu.com
#jackal
NEXT_PUBLIC_RPC_URL_JACKAL=wss://rpc.jackal.chaintools.tech
NEXT_PUBLIC_REST_URL_JACKAL=https://api.jackal.chaintools.tech
#flix
NEXT_PUBLIC_RPC_URL_FLIX=wss://rpc.omniflix.chaintools.tech
NEXT_PUBLIC_REST_URL_FLIX=https://omniflix-rest.publicnode.com
#atone
NEXT_PUBLIC_RPC_URL_ATOMONE=wss://rpc.atomone.chaintools.tech
NEXT_PUBLIC_REST_URL_ATOMONE=https://atomone.api.nodeshub.online

NEXT_PUBLIC_EXPLORER_URL=https://explorer.getbze.com

#Locker address for permanently locked liquidity
NEXT_PUBLIC_LOCKER_ADDRESS=bze1pc5zjcvhx3e8l305zjl72grytfa30r5mdypmw4

#AtomOne validator support program
NEXT_PUBLIC_ATONE_VALIDATOR_SUPPORTED_DENOMS=ibc/82931180F0962712BFABB189083A94C77EA90E269ABFC6D310AF922B2B14E011,ibc/B2219CA05421EA988F83E5E824BF69362E80A6A87503EFD18B92C91C9E03763D
NEXT_PUBLIC_ATONE_VALIDATOR_PAGE_URL=https://explorer.getbze.com/atomone/staking/atonevaloper1sa42hn5fuupm5wpgz6msx4nmrpec6az96vjqjw

# Runtime-only, read by the server-side Skip proxy at request time — NEVER baked
# into the image. Leave empty here; the real value is injected into the
# container environment on the production server.
SKIP_API_KEY=
