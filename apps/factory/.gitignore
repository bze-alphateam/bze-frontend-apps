# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.dist
!.env.mainnet.dist
!.env.testnet.dist
# e2e build env: fake *.e2e.test hosts, no secrets (BFE-143)
!.env.e2e

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.idea
.claude
